{
  "name": "vscode-codex-extension",
  "displayName": "Agent Sessions",
  "description": "Codex / Claude Code のセッションをエディタタブとして開き、履歴から復元する",
  "version": "0.0.1",
  "license": "MIT",
  "publisher": "Sylphy0052",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Sylphy0052/VSCode-Codex-Extension.git"
  },
  "engines": {
    "node": ">=20",
    "vscode": "^1.90.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codexSessions",
          "title": "Agents",
          "icon": "resources/agents.svg"
        }
      ]
    },
    "views": {
      "codexSessions": [
        {
          "id": "codex.controlPanel",
          "type": "webview",
          "name": "設定"
        },
        {
          "id": "codex.sessions",
          "name": "履歴"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "codex.sessions",
        "contents": "このワークスペースのセッションはまだありません。\n[新しい会話（Codex）](command:codex.newChat)\n[新しい会話（Claude Code）](command:claude.newChat)\n全ワークスペースのセッションを見るには表示範囲を切り替えてください。"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "codex.newChat",
          "when": "view == codex.sessions",
          "group": "navigation@1"
        },
        {
          "command": "claude.newChat",
          "when": "view == codex.sessions",
          "group": "navigation@2"
        },
        {
          "command": "codex.showAllSessions",
          "when": "view == codex.sessions && codex.historyScope != all",
          "group": "navigation@3"
        },
        {
          "command": "codex.showWorkspaceSessions",
          "when": "view == codex.sessions && codex.historyScope == all",
          "group": "navigation@3"
        },
        {
          "command": "codex.refreshSessions",
          "when": "view == codex.sessions",
          "group": "navigation@4"
        }
      ],
      "editor/title": [
        {
          "command": "codex.renameChat",
          "when": "activeWebviewPanelId == codex.chat",
          "group": "navigation@100"
        },
        {
          "command": "claude.renameChat",
          "when": "activeWebviewPanelId == claude.chat",
          "group": "navigation@100"
        },
        {
          "command": "codex.newChat",
          "when": "resourceScheme == file",
          "group": "navigation@100"
        },
        {
          "command": "claude.newChat",
          "when": "resourceScheme == file",
          "group": "1_new@1"
        }
      ],
      "view/item/context": [
        {
          "command": "claude.openChat",
          "when": "view == codex.sessions && viewItem =~ /^codexSession\\.claude/",
          "group": "inline@1"
        },
        {
          "command": "claude.openChat",
          "when": "view == codex.sessions && viewItem =~ /^codexSession\\.claude/",
          "group": "1_open@0"
        },
        {
          "command": "codex.openChat",
          "when": "view == codex.sessions && viewItem =~ /^codexSession\\.codex/",
          "group": "inline@1"
        },
        {
          "command": "codex.openChat",
          "when": "view == codex.sessions && viewItem =~ /^codexSession\\.codex/",
          "group": "1_open@0"
        },
        {
          "command": "codex.openConversation",
          "when": "view == codex.sessions && viewItem =~ /^codexSession\\.codex/",
          "group": "inline@2"
        },
        {
          "command": "codex.openConversation",
          "when": "view == codex.sessions && viewItem =~ /^codexSession\\.codex/",
          "group": "1_open@0"
        },
        {
          "command": "codex.forkSession",
          "when": "view == codex.sessions && viewItem =~ /^codexSession/",
          "group": "1_open@1"
        },
        {
          "command": "codex.archiveSession",
          "when": "view == codex.sessions && viewItem == codexSession.codex",
          "group": "2_manage@1"
        },
        {
          "command": "codex.unarchiveSession",
          "when": "view == codex.sessions && viewItem == codexSession.codex.archived",
          "group": "2_manage@1"
        },
        {
          "command": "codex.deleteSession",
          "when": "view == codex.sessions && viewItem =~ /^codexSession\\.codex/",
          "group": "3_destructive@1"
        }
      ],
      "commandPalette": [
        {
          "command": "codex.openSession",
          "when": "false"
        },
        {
          "command": "codex.openChat",
          "when": "false"
        },
        {
          "command": "codex.openConversation",
          "when": "false"
        },
        {
          "command": "codex.forkSession",
          "when": "false"
        },
        {
          "command": "codex.archiveSession",
          "when": "false"
        },
        {
          "command": "codex.unarchiveSession",
          "when": "false"
        },
        {
          "command": "codex.deleteSession",
          "when": "false"
        },
        {
          "command": "claude.openChat",
          "when": "false"
        }
      ]
    },
    "commands": [
      {
        "command": "codex.openSession",
        "title": "セッションを開く",
        "category": "Agent"
      },
      {
        "command": "codex.resumeSession",
        "title": "セッションを再開…",
        "category": "Agent"
      },
      {
        "command": "codex.resumeLast",
        "title": "直前のセッションを再開",
        "category": "Agent"
      },
      {
        "command": "codex.refreshSessions",
        "title": "更新",
        "category": "Agent",
        "icon": "$(refresh)"
      },
      {
        "command": "codex.showAllSessions",
        "title": "全ワークスペースを表示",
        "category": "Agent",
        "icon": "$(globe)"
      },
      {
        "command": "codex.showWorkspaceSessions",
        "title": "このワークスペースのみ表示",
        "category": "Agent",
        "icon": "$(filter-filled)"
      },
      {
        "command": "codex.newChat",
        "title": "新しい会話（Codex）",
        "category": "Agent",
        "icon": "$(add)"
      },
      {
        "command": "codex.renameChat",
        "title": "セッション名を変更",
        "category": "Agent",
        "icon": "$(edit)"
      },
      {
        "command": "codex.openChat",
        "title": "チャット画面で開く（Codex）",
        "category": "Agent",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "codex.openConversation",
        "title": "会話を開いて分岐する",
        "category": "Agent",
        "icon": "$(git-branch)"
      },
      {
        "command": "codex.forkSession",
        "title": "このセッションをforkする",
        "category": "Agent"
      },
      {
        "command": "codex.archiveSession",
        "title": "アーカイブする",
        "category": "Agent"
      },
      {
        "command": "codex.unarchiveSession",
        "title": "アーカイブを解除する",
        "category": "Agent"
      },
      {
        "command": "codex.deleteSession",
        "title": "削除する",
        "category": "Agent"
      },
      {
        "command": "codex.showUsage",
        "title": "使用量を表示",
        "category": "Agent"
      },
      {
        "command": "codex.showLog",
        "title": "ログを表示",
        "category": "Agent"
      },
      {
        "command": "claude.newChat",
        "title": "新しい会話（Claude Code）",
        "category": "Agent",
        "icon": "$(sparkle)"
      },
      {
        "command": "claude.openChat",
        "title": "チャット画面で開く（Claude Code）",
        "category": "Agent",
        "icon": "$(sparkle)"
      },
      {
        "command": "claude.reloadSkills",
        "title": "skillsを読み直す（Claude Code）",
        "category": "Agent"
      },
      {
        "command": "claude.renameChat",
        "title": "セッション名を変更（Claude Code）",
        "category": "Agent",
        "icon": "$(edit)"
      },
      {
        "command": "agent.workflows.run",
        "title": "ワークフローを実行…",
        "category": "Agent"
      },
      {
        "command": "agent.workflows.stop",
        "title": "ワークフローを停止…",
        "category": "Agent"
      },
      {
        "command": "agent.workflows.roadmap",
        "title": "ロードマップを生成…",
        "category": "Agent"
      },
      {
        "command": "agent.workflows.view",
        "title": "ワークフローViewを開く",
        "category": "Agent"
      },
      {
        "command": "agent.workflows.plan",
        "title": "ゴール文からワークフローを生成…",
        "category": "Agent"
      }
    ],
    "configuration": {
      "title": "Agent Sessions",
      "properties": {
        "codex.executablePath": {
          "type": "string",
          "default": "codex",
          "scope": "machine",
          "markdownDescription": "codex実行ファイルのパス。パス区切りを含まない場合はPATHから探す。\n\nリポジトリ側の設定から任意のバイナリを起動されないよう machine スコープに固定している。"
        },
        "codex.codexHome": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "CODEX_HOME のパス。空なら環境変数、それも無ければ `~/.codex` を使う。"
        },
        "codex.additionalArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine",
          "markdownDescription": "codex起動時に追加で渡す引数。"
        },
        "codex.sandbox": {
          "type": "string",
          "enum": [
            "",
            "read-only",
            "workspace-write",
            "danger-full-access"
          ],
          "default": "",
          "scope": "machine",
          "markdownDescription": "サンドボックスの方針。空なら `~/.codex/config.toml` に委譲する。会話の途中で変えると次の発言から効く。"
        },
        "codex.sandboxWritableRoots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine",
          "markdownDescription": "`workspace-write` のときに作業フォルダの外で書き込みを許す場所。**絶対パスのみ**（相対パスは無視する）。TUIの `/sandbox-add-read-dir` に相当する。"
        },
        "codex.sandboxNetworkAccess": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "markdownDescription": "`workspace-write` のときにネットワークへ出られるようにする。"
        },
        "codex.approvalMode": {
          "type": "string",
          "enum": [
            "",
            "untrusted",
            "on-request",
            "never"
          ],
          "default": "",
          "scope": "machine",
          "markdownDescription": "コマンド実行の承認方針。空なら `~/.codex/config.toml` に委譲する。"
        },
        "codex.model": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "使用するモデル。空なら `-m` を渡さない。"
        },
        "codex.reasoningEffort": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "推論の深さ (`model_reasoning_effort`)。空なら `~/.codex/config.toml` に委譲する。選択肢はモデルごとに異なるため、サイドバーの設定パネルから選ぶことを推奨。"
        },
        "codex.profile": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "`-p` に渡すCodexのプロファイル名。"
        },
        "codex.history.scope": {
          "type": "string",
          "enum": [
            "workspace",
            "all"
          ],
          "default": "workspace",
          "scope": "window",
          "markdownDescription": "履歴一覧に出す範囲。`workspace` は現在のワークスペース配下のセッションのみ。"
        },
        "codex.history.maxEntries": {
          "type": "number",
          "default": 200,
          "minimum": 1,
          "scope": "window",
          "markdownDescription": "履歴一覧を構築する際に読む最大件数。更新時刻の新しい順に絞る。"
        },
        "agent.activityLog.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "markdownDescription": "この拡張機能から実行したセッションを日報/週報用のバッファへ記録する。記録するのはセッションごとに1行（時刻・作業ディレクトリ・要約）だけで、会話本文は書き出さない。"
        },
        "agent.activityLog.dir": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "作業記録の出力先ディレクトリ。空なら環境変数 `DAILY_BUFFER_DIR`、それも無ければ `~/workspace/dairy/.buffer` を使う。"
        },
        "agent.workflows.dir": {
          "type": "string",
          "default": ".agents/workflows",
          "scope": "resource",
          "markdownDescription": "ワークフロー定義ファイル（`.yaml` / `.yml`）を探すディレクトリ。ワークスペースフォルダからの相対パス。"
        },
        "agent.workflows.allowAutoApprove": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "markdownDescription": "ワークフロー定義（YAML）の `autoApprove: true` を有効化できるようにする。無効のままだと、YAMLに何と書かれていても全ての承認要求を人へ回す。リポジトリ側のYAMLから無人実行を勝手に有効化されないよう machine スコープに固定している（設計書 §16.16）。"
        },
        "agent.workflows.replyTimeoutSec": {
          "type": "number",
          "default": 300,
          "minimum": 1,
          "scope": "machine-overridable",
          "markdownDescription": "タスク間のメッセージング（`send_message` の `expectReply: true`）で、返信を待つ時間の上限（秒）。超えたタスクは返信を待たずに再開する（設計書 §16.21）。"
        },
        "agent.workflows.roadmapDir": {
          "type": "string",
          "default": "docs/roadmap",
          "scope": "machine-overridable",
          "markdownDescription": "ロードマップ（`workflow.roadmap` で生成するMarkdown）の出力先ディレクトリ。ワークスペースフォルダからの相対パス。出力先はワークスペースフォルダの配下に限る（設計書 §16.16・§16.19）。"
        },
        "agent.workflows.pseudoWorktreeExclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "node_modules",
            ".venv",
            "dist",
            "out"
          ],
          "scope": "machine-overridable",
          "markdownDescription": "ワークスペースがgitの作業ツリーでない場合の隔離（疑似worktree）で、複製から除外するディレクトリ名。深さを問わず名前が一致するディレクトリを除外する。`.agents/worktrees` 自身は常に除外される（設計書 §16.20）。"
        },
        "agent.workflows.forge": {
          "type": "string",
          "enum": [
            "auto",
            "github",
            "gitlab",
            "none"
          ],
          "default": "auto",
          "scope": "machine",
          "markdownDescription": "PR/MRの作成に使うホストの選択。`auto` は `origin` のリモートURLから判定する（`github.com` はGitHub、ホスト名に `gitlab` を含めばGitLab）。自己ホストのGitHub Enterpriseなど名前から判定できない場合は `github` / `gitlab` を明示する。`none` はPR/MRを作らない。実行するコマンド（`gh` / `glab`）の選択にあたるため、machineスコープに固定している。リポジトリの `.vscode/settings.json` からは変えられない（設計書 §16.16・§16.18）。"
        },
        "agent.workflows.pullRequest": {
          "type": "string",
          "enum": [
            "none",
            "integration",
            "per-task"
          ],
          "default": "per-task",
          "scope": "machine-overridable",
          "markdownDescription": "作るPR/MRの層。`per-task` はタスクブランチ→統合ブランチ（タスクごと）と統合ブランチ→main（runごと1本）の両方、`integration` は統合ブランチ→mainのみ、`none` はPR/MRを作らない（設計書 §16.18）。"
        },
        "agent.workflows.finalMerge": {
          "type": "string",
          "enum": [
            "auto",
            "pr-only"
          ],
          "default": "auto",
          "scope": "machine",
          "markdownDescription": "統合ブランチ→mainのPR/MRを無人でマージするか。`auto` は `gh pr merge --merge` / `glab mr merge --remove-source-branch` まで実行する。`pr-only` はPR/MRを作って止め、mainへの書き込みは人が行う。mainを無人で書き換えるかどうかを決めるため、machineスコープに固定している。リポジトリの `.vscode/settings.json` から `auto` へは変えられない。MRの自己マージを禁じる運用規約を持つ組織では `pr-only` にする（設計書 §16.16・§16.18）。"
        },
        "claude.executablePath": {
          "type": "string",
          "default": "claude",
          "scope": "machine",
          "markdownDescription": "claude実行ファイルのパス。パス区切りを含まない場合はPATHから探す。\n\nリポジトリ側の設定から任意のバイナリを起動されないよう machine スコープに固定している。"
        },
        "claude.configDir": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Claude Codeの設定ディレクトリ。空なら環境変数 `CLAUDE_CONFIG_DIR`、それも無ければ `~/.claude` を使う。"
        },
        "claude.additionalArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine",
          "markdownDescription": "claude起動時に追加で渡す引数。"
        },
        "claude.permissionMode": {
          "type": "string",
          "enum": [
            "",
            "manual",
            "auto",
            "acceptEdits",
            "plan",
            "dontAsk",
            "bypassPermissions"
          ],
          "default": "",
          "scope": "machine",
          "markdownDescription": "ツール実行の承認方針。空なら Claude Code 側の設定に委譲する。`bypassPermissions` は全確認を飛ばすため、起動前に確認ダイアログを出す。"
        },
        "claude.model": {
          "type": "string",
          "default": "opus",
          "scope": "machine-overridable",
          "markdownDescription": "使用するモデル。エイリアス (`opus` / `sonnet` / `fable` / `haiku`) か正式名を指定する。空なら `--model` を渡さず、Claude Code 側の設定 (`~/.claude/settings.json`) に委譲する。"
        },
        "claude.effort": {
          "type": "string",
          "enum": [
            "",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "default": "medium",
          "scope": "machine-overridable",
          "markdownDescription": "推論の深さ (`--effort`)。空なら渡さず、Claude Code 側の設定に委譲する。"
        },
        "claude.agent": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "使用するエージェント (`--agent`)。組込エージェント (`claude` / `Explore` / `Plan` / `general-purpose` など) やユーザー定義のカスタムエージェントの名前を指定する。空なら渡さず、Claude Code 側の `agent` 設定に委譲する。起動時にのみ効き、会話の途中では切り替えられない。"
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node20",
    "watch": "npm run build -- --sourcemap --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "compile:integration": "tsc -p tsconfig.integration.json",
    "build:integration": "npm run build && npm run compile:integration",
    "test:integration": "npm run build:integration && vscode-test",
    "test:integration:xvfb": "npm run build:integration && bash scripts/xvfb-vscode-test.sh",
    "check": "bash scripts/check.sh",
    "package": "npm run build && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.90.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "eslint": "^9.17.0",
    "mocha": "^11.8.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
